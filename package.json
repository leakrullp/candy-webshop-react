{
  "name": "candy-webshop-react",
  "version": "1.0.0",
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "install-all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leakrullp/candy-webshop-react.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/leakrullp/candy-webshop-react/issues"
  },
  "homepage": "https://github.com/leakrullp/candy-webshop-react#readme",
  "dependencies": {
    "express": "^5.2.1",
    "react-router-dom": "^7.15.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "vite": "^8.0.13"
  }
}
